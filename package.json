{
  "name": "invoice-constructor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "npm run lint:eslint && npm run lint:styles && npm run lint:prettier && npm run lint:fsd && npm run ts-check",
    "lint:eslint": "eslint \"**/*.{ts,tsx}\" --cache --cache-strategy content",
    "lint:eslint:fix": "npm run lint:eslint -- --fix",
    "lint:fix": "npm run lint:eslint:fix && npm run lint:styles:fix && npm run format",
    "lint:fsd": "steiger ./src",
    "lint:fsd:fix": "steiger --fix ./src",
    "lint:prettier": "prettier --check \"**/*.{ts,tsx,css,json,md,yml,yaml}\"",
    "lint:styles": "stylelint \"**/*.css\"",
    "lint:styles:fix": "npm run lint:styles -- --fix",
    "pre-commit-lint": "lint-staged --quiet",
    "prepare": "husky",
    "preview": "vite preview",
    "ts-check": "tsc -b --pretty"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "steiger": "^0.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
